@base = http://localhost:3000/api/v1

### especies
GET {{base}}/especies

### solo las de luz alta
GET {{base}}/especies?luz=alta

### crear
# @name potus
POST {{base}}/especies
Content-Type: application/json

{
  "nombreComun": "Potus",
  "nombreCientifico": "Epipremnum aureum",
  "luz": "media",
  "frecuenciaRiegoDias": 7,
  "frecuenciaAbonoDias": 30
}

### ver la que cree recien
GET {{base}}/especies/{{potus.response.body.id}}

### id que no existe, tiene que dar 404
GET {{base}}/especies/123

### a ver si tira 422 con luz rara
POST {{base}}/especies
Content-Type: application/json

{
  "nombreComun": "Helecho",
  "luz": "muchisima",
  "frecuenciaRiegoDias": 3,
  "frecuenciaAbonoDias": 20
}

### riego en 0 tambien deberia ser 422
POST {{base}}/especies
Content-Type: application/json

{
  "nombreComun": "Cactus",
  "luz": "alta",
  "frecuenciaRiegoDias": 0,
  "frecuenciaAbonoDias": 60
}

### editar el potus
PUT {{base}}/especies/{{potus.response.body.id}}
Content-Type: application/json

{
  "nombreComun": "Potus dorado",
  "luz": "baja",
  "frecuenciaRiegoDias": 10,
  "frecuenciaAbonoDias": 45
}

### borrar (204), si lo corro de nuevo da 404
DELETE {{base}}/especies/{{potus.response.body.id}}

### zonas (ya vienen del seed)
GET {{base}}/zonas

### solo las de afuera
GET {{base}}/zonas?interior=false

### crear
# @name terraza
POST {{base}}/zonas
Content-Type: application/json

{
  "nombre": "Terraza",
  "luz": "alta",
  "interior": false
}

### interior como texto, tiene que dar 422
POST {{base}}/zonas
Content-Type: application/json

{
  "nombre": "Pasillo",
  "luz": "baja",
  "interior": "si"
}

### plantas de la terraza (vacio)
GET {{base}}/zonas/{{terraza.response.body.id}}/plantas

### zona que no existe, 404
GET {{base}}/zonas/123/plantas

### borrar la terraza
DELETE {{base}}/zonas/{{terraza.response.body.id}}

### plantas, pagina 2 de a 5
GET {{base}}/plantas?page=2&limit=5

### solo las muertas
# @name muertas
GET {{base}}/plantas?estado=muerta

### limit en 0, tiene que dar 400
GET {{base}}/plantas?limit=0

### revivir la muerta: 409
PATCH {{base}}/plantas/{{muertas.response.body.datos[0].id}}
Content-Type: application/json

{
  "estado": "activa"
}

### necesito ids de especie y zona para crear
# @name especies
GET {{base}}/especies

###
# @name zonas
GET {{base}}/zonas

### especie que no existe, 422
POST {{base}}/plantas
Content-Type: application/json

{
  "apodo": "Fantasma",
  "especieId": "no-existe",
  "zonaId": "{{zonas.response.body.0.id}}",
  "fechaCompra": "2026-09-01"
}

### crear una bien
# @name nueva
POST {{base}}/plantas
Content-Type: application/json

{
  "apodo": "Ramona",
  "especieId": "{{especies.response.body.0.id}}",
  "zonaId": "{{zonas.response.body.0.id}}",
  "fechaCompra": "2026-09-01"
}

### pasarla a recuperacion
PATCH {{base}}/plantas/{{nueva.response.body.id}}
Content-Type: application/json

{
  "estado": "en_recuperacion"
}

### borrar una especie con plantas, 409
DELETE {{base}}/especies/{{especies.response.body.0.id}}

### etiquetas
# @name etiquetas
GET {{base}}/etiquetas

### repetida (con mayuscula igual cuenta), 409
POST {{base}}/etiquetas
Content-Type: application/json

{
  "nombre": "Suculentas"
}

### ponerle etiqueta, si lo mando dos veces queda igual
PUT {{base}}/plantas/{{nueva.response.body.id}}/etiquetas
Content-Type: application/json

{
  "etiquetas": ["{{etiquetas.response.body.0.id}}"]
}

### borrar la planta (204), la segunda vez 404
DELETE {{base}}/plantas/{{nueva.response.body.id}}
